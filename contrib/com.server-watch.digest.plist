<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: daily digest and deep checks at 06:30 local time. Install like the check plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.server-watch.digest</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/server-watch</string><string>digest</string><string>--deep</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardErrorPath</key><string>/tmp/server-watch.err</string>
</dict>
</plist>
